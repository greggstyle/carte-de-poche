# Variables d'environnement du paiement (Vercel : Settings > Environment Variables).
# Ne jamais mettre de vraies valeurs dans le dépôt.
# Tant qu'une des 3 premières manque, le site reste entièrement gratuit (aucun paiement demandé).
STRIPE_SECRET_KEY=rk_test_...     # clé API RESTREINTE du compte « carte de poche » (Checkout Sessions: écriture, Prices: lecture)
PRICE_STANDARD=price_...          # prix normal (4,99 EUR TTC)
UNLOCK_SECRET=...                 # 32 octets aléatoires : openssl rand -base64 32
PRICE_LAUNCH=price_...            # prix de lancement (1,99 EUR TTC), optionnel
LAUNCH_END=2026-12-31T23:59:59+04:00   # fin de l'offre de lancement (ISO 8601), optionnel
# PAYWALL=0                       # coupe-circuit : repasse tout en gratuit
