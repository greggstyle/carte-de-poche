# Variables d'environnement du paiement (Vercel : Settings > Environment Variables).
# Ne jamais mettre de vraies valeurs dans le dépôt.
# Tant qu'une des 3 premières manque, le site reste entièrement gratuit (aucun paiement demandé).
STRIPE_SECRET_KEY=rk_test_...     # clé API RESTREINTE du compte « carte de poche » (Checkout Sessions: écriture, Prices: lecture)
PRICE_STANDARD=price_...          # prix normal (4,99 EUR TTC)
UNLOCK_SECRET=...                 # 32 octets aléatoires : openssl rand -base64 32
PRICE_LAUNCH=price_...            # prix de lancement (1,99 EUR TTC), optionnel
LAUNCH_END=2026-12-31T23:59:59+04:00   # fin de l'offre de lancement (ISO 8601), optionnel
# PAYWALL=0                       # coupe-circuit : repasse tout en gratuit

# Emails de confirmation d'achat (Resend). Sans ces 4 variables, le webhook répond 503 et aucun email n'est envoyé.
STRIPE_WEBHOOK_SECRET=whsec_...   # secret de l'endpoint Stripe https://www.cartedepoche.fr/api/webhook (événement checkout.session.completed)
RESEND_API_KEY=re_...             # clé API Resend (domaine cartedepoche.fr vérifié : SPF, DKIM)
MAIL_FROM=Carte de poche <bonjour@cartedepoche.fr>
MAIL_REPLY_TO=bonjour@cartedepoche.fr

# TVA et libellé de relevé
VAT_RATE=8.5                      # taux de TVA inclus dans les prix TTC : ajoute la ligne « dont TVA » à l'email (absent = pas de ligne)
# TAX_RATE=txr_...                # optionnel : taux de TVA Stripe (inclusive) pour afficher la TVA sur le reçu Stripe
# STATEMENT_DESCRIPTOR=CARTE DE POCHE   # libellé sur le relevé bancaire du client (22 caractères max, défaut : CARTE DE POCHE)
